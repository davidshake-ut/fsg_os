# Copy to .env.local and fill in. Without the two NEXT_PUBLIC_SUPABASE_*
# values the app runs in local mode (no auth or persistence).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by the API routes (invites, members, products).
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant features.
ANTHROPIC_API_KEY=

# Public base URL of the deployed app (no trailing slash), e.g.
# https://os.fusionsg.com — pins invite/recovery email links to the
# production domain regardless of which host the admin sent them from.
# Must also be covered by the Supabase dashboard's Redirect URLs allowlist.
# Optional locally (the request origin is the fallback).
NEXT_PUBLIC_SITE_URL=
